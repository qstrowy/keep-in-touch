---
import Layout from "@/layouts/Layout.astro";
import Brand from "@/components/landing/Brand.astro";
import FirstPersonDashboard from "@/components/people/FirstPersonDashboard";
import "@/styles/app.css";

const { user } = Astro.locals;

if (!user) {
  throw new Error("Dashboard requires an authenticated user.");
}
---

<Layout title="Your people | KeepInTouch">
  <main class="kit-app min-h-screen">
    <div class="kit-app-wrap">
      <header class="kit-app-header">
        <Brand />
        <form method="POST" action="/api/auth/signout">
          <button
            class="kit-app-signout"
            type="submit"
          >
            Sign out <span aria-hidden="true">↗</span>
          </button>
        </form>
      </header>

      <section class="kit-app-intro" aria-labelledby="app-title">
        <p class="kit-app-eyebrow">A LITTLE SPACE FOR YOUR PEOPLE</p>
        <h1 id="app-title">Your people</h1>
        <p>A thoughtful place to remember what matters between conversations.</p>
      </section>

      <div class="kit-app-content">
        <FirstPersonDashboard client:load ownerId={user.id} />
      </div>
    </div>
  </main>
</Layout>
