---
import Layout from "@/layouts/Layout.astro";
import FirstPersonDashboard from "@/components/people/FirstPersonDashboard";

const { user } = Astro.locals;

if (!user) {
  throw new Error("Dashboard requires an authenticated user.");
}
---

<Layout title="Dashboard">
  <main class="bg-cosmic relative min-h-screen overflow-hidden text-white">
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <div class="absolute top-12 -left-40 h-96 w-96 rounded-full bg-blue-400/10 blur-[110px]"></div>
      <div class="absolute top-1/3 -right-40 h-[30rem] w-[30rem] rounded-full bg-purple-500/10 blur-[130px]"></div>
      <div class="absolute bottom-0 left-1/3 h-72 w-72 rounded-full bg-cyan-400/5 blur-[100px]"></div>
    </div>
    <div class="relative mx-auto flex min-h-screen w-full max-w-7xl flex-col px-4 py-6 sm:px-8 sm:py-9">
      <header class="flex items-start justify-between gap-4 border-b border-white/10 pb-6">
        <div class="min-w-0 flex-1">
          <p class="text-xs font-semibold tracking-[0.24em] text-blue-200/75 uppercase">KeepInTouch</p>
          <h1
            class="mt-2 bg-gradient-to-r from-blue-100 via-white to-purple-200 bg-clip-text text-2xl font-bold text-transparent sm:text-4xl"
          >
            Your people
          </h1>
          <p class="mt-2 max-w-xl text-xs leading-5 text-blue-100/70 sm:text-sm sm:leading-6">
            A thoughtful place to remember what matters between conversations.
          </p>
        </div>
        <form method="POST" action="/api/auth/signout" class="shrink-0 pt-1">
          <button
            type="submit"
            class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm font-medium text-blue-50/90 transition-colors hover:border-white/30 hover:bg-white/10 focus-visible:ring-2 focus-visible:ring-blue-200 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950 focus-visible:outline-none"
          >
            Sign out
          </button>
        </form>
      </header>

      <div class="mt-8 flex-1">
        <FirstPersonDashboard client:load ownerId={user.id} />
      </div>
    </div>
  </main>
</Layout>
