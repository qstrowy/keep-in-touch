---
import Layout from "@/layouts/Layout.astro";
import FirstPersonDashboard from "@/components/people/FirstPersonDashboard";

const { user } = Astro.locals;

if (!user) {
  throw new Error("Dashboard requires an authenticated user.");
}
---

<Layout title="Dashboard">
  <main class="bg-cosmic flex min-h-screen items-center justify-center p-4 text-white">
    <div class="w-full max-w-lg rounded-2xl border border-white/10 bg-white/10 p-8 backdrop-blur-xl">
      <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Your people
      </h1>
      <p class="mt-2 text-sm text-blue-100/75">A private place for the people you want to keep in touch with.</p>

      <div class="mt-8">
        <FirstPersonDashboard client:load ownerId={user.id} />
      </div>

      <form method="POST" action="/api/auth/signout" class="mt-8 border-t border-white/10 pt-6">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Sign out
        </button>
      </form>
    </div>
  </main>
</Layout>
