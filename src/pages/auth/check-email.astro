---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Check your email | KeepInTouch">
  <main class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <section
      aria-labelledby="check-email-title"
      class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <a href="/" class="mb-6 block text-sm font-semibold tracking-wide text-purple-200 hover:text-purple-100">
        KeepInTouch
      </a>
      <div class="mb-4 text-5xl">📧</div>
      <h1
        id="check-email-title"
        class="mb-3 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent"
      >
        Check your email
      </h1>
      <p class="mb-6 text-blue-100/80">
        If this email can be used to sign in, we’ve sent a link. Open it in this browser to continue.
      </p>
      <a href="/auth/signin" class="text-sm text-purple-300 hover:underline">Request another link</a>
    </section>
  </main>
</Layout>
