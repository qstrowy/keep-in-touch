---
import PublicLayout from "@/layouts/PublicLayout.astro";
import Brand from "@/components/landing/Brand.astro";
import CoffeeCups from "@/components/landing/CoffeeCups.astro";
---

<PublicLayout title="Check your email | KeepInTouch">
  <header class="kit-header kit-wrap">
    <Brand /><a class="kit-text-link" href="/">Back home <span aria-hidden="true">↗</span></a>
  </header>
  <main class="kit-check-email kit-wrap">
    <CoffeeCups />
    <p class="kit-eyebrow">A LITTLE LINK. THEN YOU'RE IN.</p>
    <h1 id="check-email-title" class="kit-auth-title">Check your email</h1>
    <p>If this email can be used to sign in, we’ve sent a link. Open it in this browser to continue.</p>
    <a href="/auth/signin" class="kit-button">Request another link <span aria-hidden="true">↗</span></a>
  </main>
</PublicLayout>
