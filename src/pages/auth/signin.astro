---
import PublicLayout from "@/layouts/PublicLayout.astro";
import Brand from "@/components/landing/Brand.astro";
import MagicLinkForm from "@/components/auth/MagicLinkForm";

const error = Astro.url.searchParams.get("error");
---

<PublicLayout title="Sign in | KeepInTouch">
  <header class="kit-header kit-wrap">
    <Brand /><a class="kit-text-link" href="/">Back to the little things <span aria-hidden="true">↗</span></a>
  </header>
  <main class="kit-auth-layout kit-wrap">
    <div class="kit-auth-story">
      <p class="kit-eyebrow">A LITTLE SPACE FOR YOUR PEOPLE</p>
      <h2>Good to see<br /><em>you here.</em></h2>
      <p>The next conversation starts with<br />a little something you remembered.</p>
      <img
        src="/landing/friends-v1.webp"
        alt="Two illustrated friends catching up over coffee."
        width="1200"
        height="800"
      />
    </div>
    <section aria-labelledby="signin-title" class="kit-auth-sheet">
      <span class="kit-auth-corner" aria-hidden="true">hello again ↗</span>
      <h1 id="signin-title" class="kit-auth-title">Sign in</h1>
      <p class="kit-auth-intro">Enter your email and we’ll send you a secure sign-in link. No password to remember.</p>
      <div class="kit-auth-form"><MagicLinkForm serverError={error} client:load /></div>
      <p class="kit-auth-footnote">New here? Your first sign-in link creates your private account.</p>
      <a class="kit-auth-privacy-link" href="/#your-space">A note about your notes <span aria-hidden="true">↗</span></a>
    </section>
  </main>
  <footer class="kit-auth-footer kit-wrap">For the little things that bring us closer.</footer>
</PublicLayout>
