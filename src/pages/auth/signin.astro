---
import Layout from "@/layouts/Layout.astro";
import MagicLinkForm from "@/components/auth/MagicLinkForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in | KeepInTouch">
  <main class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <section
      aria-labelledby="signin-title"
      class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl"
    >
      <a
        href="/"
        class="mb-6 block text-center text-sm font-semibold tracking-wide text-purple-200 hover:text-purple-100"
      >
        KeepInTouch
      </a>
      <h1
        id="signin-title"
        class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent"
      >
        Sign in
      </h1>
      <p class="mb-6 text-center text-sm text-blue-100/70">
        Enter your email and we’ll send you a secure sign-in link.
      </p>
      <MagicLinkForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-blue-100/60">
        New here? Your first sign-in link creates your private account.
      </p>
    </section>
  </main>
</Layout>
